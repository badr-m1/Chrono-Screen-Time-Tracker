{
    "name": "Time Tracker",
    "version": "0.1.0",
    "description": "Tracking browser usage time",
    "permissions": ["storage", "tabs", "alarms", "scripting"],
    "host_permissions": ["http://*/*","https://*/*"],
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "action": {
      "default_title": "Time Tracker",
      "default_popup": "index.html"
    },
    "manifest_version": 3
}
